
# Application
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL="postgresql://saas_user:saas_password@127.0.0.1:5434/saas_platform?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
RAZORPAY_PLAN_STARTER_MONTHLY=replace_with_your_plan_id

# Email SMTP (Ethereal test account)
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=replace_with_ethereal_username
MAIL_PASSWORD=replace_with_ethereal_password
MAIL_FROM="SaaS Subscription Platform <noreply@example.com>"

# Invoice storage
INVOICE_STORAGE_PATH=./storage/invoices

# MCP
MCP_SERVER_NAME=saas-analytics
